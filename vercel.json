{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'No build step required for static HTML prototypes'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/prototypes/portfolio-v4.html" },
    { "source": "/projects", "destination": "/prototypes/projects.html" },
    { "source": "/about", "destination": "/prototypes/about.html" },
    { "source": "/roadmap", "destination": "/prototypes/cs-roadmap.html" }
  ]
}
