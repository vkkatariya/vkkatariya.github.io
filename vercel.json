{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'No build step required for static HTML prototype'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/prototypes/portfolio-combined.html" },
    { "source": "/projects", "destination": "/prototypes/portfolio-combined.html#projects" },
    { "source": "/about", "destination": "/prototypes/portfolio-combined.html#about" },
    { "source": "/roadmap", "destination": "/prototypes/portfolio-combined.html#roadmap" }
  ]
}